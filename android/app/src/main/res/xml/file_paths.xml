<paths>
    <!-- Backups live in getExternalFilesDir(null)/Backups (BackupStorage). -->
    <external-files-path name="backups" path="Backups/" />
    <!-- Fallback location when external storage is unavailable. -->
    <files-path name="local_backups" path="Backups/" />
</paths>
